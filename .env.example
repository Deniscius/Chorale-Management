APP_NAME="Gestion Chorale"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL : créer une base dédiée avant de lancer les migrations.
DB_CONNECTION=pgsql
# Sur Render avec Neon : définir DB_URL dans les secrets Render, jamais dans Git.
# Utiliser l'endpoint direct et sslmode=verify-full (voir docs/MIGRATION-NEON.md).
DB_URL=
# neon deploy/env pull fournit ces deux valeurs confidentielles dans .env.
# DB_URL explicite reste prioritaire ; sinon Laravel préfère la connexion directe.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=chorale
DB_USERNAME=chorale
DB_PASSWORD=
DB_SSLMODE=prefer
# Production Neon : /etc/ssl/certs/ca-certificates.crt dans l'image Docker.
DB_SSLROOTCERT=

# Banc Compose : dimensionner avec les workers web, les files et la mémoire.
PG_MAX_CONNECTIONS=100
PG_SHARED_BUFFERS=128MB

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Développement : les messages sont écrits dans les logs (storage/logs/laravel.log).
# Production : renseigner un serveur SMTP.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="contact@chorale.ci"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---------------------------------------------------------------------------
# Rappels de répétition
# ---------------------------------------------------------------------------
# Envoi automatique d'un rappel aux choristes actifs avant chaque répétition.
REMINDERS_ENABLED=true
# Nombre de jours entre l'envoi et la répétition.
REMINDERS_DAYS_BEFORE=2
# Heure d'envoi par le planificateur.
REMINDERS_SEND_AT=08:00
# Canal SMS : nécessite un fournisseur (D7 ci-dessous ou passerelle SMS_ENDPOINT).
REMINDERS_SMS_ENABLED=false
# « log » (développement), « http » (passerelle) ou « d7 » (D7 Networks).
REMINDERS_SMS_DRIVER=log
REMINDERS_SMS_FROM="CHORALE"

# Passerelle SMS HTTP : corps JSON { from, to, message }, jeton Bearer.
SMS_ENDPOINT=
SMS_TOKEN=
SMS_TIMEOUT=15

# D7 Networks : jeton secret uniquement sur le serveur, jamais dans VITE_* ou Git.
# Activer après validation du compte, du crédit et du nom expéditeur chez D7.
D7_API_TOKEN=
D7_SMS_ORIGINATOR="CHORALE"

# ---------------------------------------------------------------------------
# Assistant IA (facultatif)
# ---------------------------------------------------------------------------
# Désactivé par défaut : l'application fonctionne sans.
AI_ENABLED=false
# « openrouter » (service hébergé) ou « ollama » (modèle local).
AI_PROVIDER=openrouter
AI_OPENROUTER_KEY=
AI_OPENROUTER_URL=https://openrouter.ai/api/v1
AI_OPENROUTER_MODEL=anthropic/claude-3.5-haiku
AI_OLLAMA_URL=http://127.0.0.1:11434
AI_OLLAMA_MODEL=llama3.1
AI_TIMEOUT=45
AI_MAX_TOKENS=700

VITE_APP_NAME="${APP_NAME}"

# Un worker queue:work est requis pour les rappels.
REMINDERS_QUEUED=true
REMINDERS_LEASE_MINUTES=60

# Espaces clients et essai gratuit de 72 heures.
TENANCY_ENABLED=true
TENANT_REGISTRATION_ENABLED=true
CHARIOW_PAYMENT_URL=
# Produit de licence mensuelle : 2 000 XOF par chorale, renouvellement à configurer sur Chariow.
CHARIOW_API_KEY=
CHARIOW_PRODUCT_ID=
