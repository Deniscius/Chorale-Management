<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- <env name="DB_CONNECTION" value="sqlite"/> -->
        <!-- <env name="DB_DATABASE" value=":memory:"/> -->
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="REMINDERS_QUEUED" value="false"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>

        <!--
            Isolation vis-à-vis des caches de production.

            Si `php artisan optimize` a été exécuté, bootstrap/cache/config.php
            contient la configuration de production : elle prend le pas sur les
            variables ci-dessus (base de données, session, file d'attente). En
            pointant les caches vers des fichiers inexistants, les tests
            reconstruisent toujours une configuration propre et ne peuvent plus
            toucher à la base de développement.
        -->
        <env name="APP_CONFIG_CACHE" value="bootstrap/cache/config.testing.php"/>
        <env name="APP_ROUTES_CACHE" value="bootstrap/cache/routes.testing.php"/>
        <env name="APP_EVENTS_CACHE" value="bootstrap/cache/events.testing.php"/>
        <env name="APP_SERVICES_CACHE" value="bootstrap/cache/services.testing.php"/>
        <env name="APP_PACKAGES_CACHE" value="bootstrap/cache/packages.testing.php"/>
    </php>
</phpunit>
